{
  "name": "spa-monitor-card",
  "version": "0.1.1",
  "description": "Home Assistant Lovelace card for HotSpring/ESP-IQ2020 water care monitoring with vertical bar gauges and salt system controls",
  "type": "module",
  "main": "dist/spa-monitor-card.js",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c --watch",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "check": "npm test && npm run build && npm run test:browser && npm run verify:artifact",
    "verify:artifact": "node scripts/verify-artifact.mjs"
  },
  "engines": {
    "node": ">=22 <27"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JoeQuantum/spa-monitor-card"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "custom-card",
    "hot-tub",
    "spa",
    "water-quality",
    "esp-iq2020",
    "hotspring"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "lit-element": "2.5.1",
    "lit-html": "1.4.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "rollup": "4.68.3",
    "@rollup/plugin-terser": "1.0.2"
  }
}
